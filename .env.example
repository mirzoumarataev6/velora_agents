APP_NAME="Velora Agents"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must stay ABOVE the longest job timeout (KnowledgeJob: 300s), or the queue
# hands a still-running job to a second worker and the work is done twice.
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT=30
GEMINI_CONNECT_TIMEOUT=10
GEMINI_RETRY_TIMES=3
GEMINI_RETRY_DELAY_MS=500
GEMINI_EMBEDDING_BATCH_SIZE=20

VITE_APP_NAME="${APP_NAME}"

# OpenAI (LLM provider â€” see config/agent.php llm_provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Instagram (instagrapi) microservice - see instagram_service/. This service
# holds NO Instagram credentials of its own: each agent owner's username and
# password are entered on that agent's Channels tab, stored (encrypted) in
# the channels table, and pushed to the running service per-channel via
# POST /connect when the channel is saved. Multi-tenant by design - do not
# add INSTAGRAM_USERNAME/INSTAGRAM_PASSWORD here.
INSTAGRAM_SERVICE_URL=http://127.0.0.1:8001
# Read by instagram_service/main.py itself (not by Laravel) - where it POSTs
# newly-seen DMs. Change only if `php artisan serve` binds a different port.
LARAVEL_URL=http://127.0.0.1:8000
